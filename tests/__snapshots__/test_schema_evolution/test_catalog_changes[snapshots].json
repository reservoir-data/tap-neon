  "replication_method": "FULL_TABLE",
  "schema": {
    "properties": {
      "created_at": {
        "description": "Timestamp when the snapshot was created, in RFC 3339 format (UTC).",
        "type": [
          "string",
          "null"
        ]
      },
      "diff_size": {
        "description": "Incremental Postgres storage size in bytes since the previous scheduled snapshot, when the snapshot is billed on incremental (diff) usage.\n\nWhen absent, either the incremental size has not been calculated yet and the snapshot is not being charged, or the snapshot is charged at full logical size (in that case `full_size` is set).\n",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "expires_at": {
        "description": "RFC 3339 timestamp when the snapshot expires and is eligible for deletion. Null if the snapshot does not have an expiry.",
        "type": [
          "string",
          "null"
        ]
      },
      "full_size": {
        "description": "Full logical size of the snapshot in bytes at the time it was taken.\n\nWhen absent, the logical size has not been calculated yet and the snapshot is not being charged.\n\nWhen present, a value of 0 means the snapshot is not being charged.\n",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "id": {
        "description": "The snapshot ID.",
        "type": [
          "string",
          "null"
        ]
      },
      "lsn": {
        "description": "WAL position (Log Sequence Number) at which the snapshot was captured, in Postgres LSN format (for example, `0/3000000`).",
        "type": [
          "string",
          "null"
        ]
      },
      "manual": {
        "description": "True if the snapshot was created manually rather than by a schedule.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "name": {
        "description": "Human-readable label for the snapshot.",
        "type": [
          "string",
          "null"
        ]
      },
      "source_branch_id": {
        "description": "Branch from which this snapshot was created.",
        "type": [
          "string",
          "null"
        ]
      },
      "timestamp": {
        "description": "Point in time captured by the snapshot, in RFC 3339 format (UTC).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "name",
      "created_at"
    ],
    "type": "object"
  },
  "stream": "snapshots",
  "tap_stream_id": "snapshots"
